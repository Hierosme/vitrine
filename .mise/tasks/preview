#!/usr/bin/env bash
#MISE description="Aperçu simultané du site (:8000) et de la doc projet (:8001)"
#MISE depends=["install"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

trap 'kill $(jobs -p) 2>/dev/null || true' EXIT INT TERM

mkdocs serve -f mkdocs.yml      -a 127.0.0.1:8000 2>&1 | sed -u 's/^/[site] /' &
mkdocs serve -f mkdocs.docs.yml -a 127.0.0.1:8001 2>&1 | sed -u 's/^/[docs] /' &

echo "▶ Site       : http://127.0.0.1:8000"
echo "▶ Doc projet : http://127.0.0.1:8001"
echo "  (Ctrl-C pour arrêter)"
wait
