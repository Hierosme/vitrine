#!/usr/bin/env bash
#MISE description="Aperçu du site (:8000) ; la doc projet se prévisualise dans vitrine-back (mise run docs:serve)"
#MISE depends=["install"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

source .mise/lib/zensical.sh
trap 'kill $(jobs -p) 2>/dev/null || true' EXIT INT TERM

cfg="$(zensical_config zensical.toml)"
zensical serve -f "$cfg"               -a 127.0.0.1:8000 2>&1 | sed -u 's/^/[site] /' &

echo "▶ Site       : http://127.0.0.1:8000"
echo "  (Ctrl-C pour arrêter)"
wait
