#!/usr/bin/env bash
#MISE description="Liste les TODO égarés dans le site et la configuration (le travail en attente vit dans private/backlog.md)"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

if grep -rn --color=auto 'TODO' site zensical.toml; then
  echo
  echo "$(grep -rc 'TODO' site zensical.toml | awk -F: '{s+=$2} END{print s}') TODO restant(s)."
else
  echo "✔ Aucun TODO dans les sources. Travail en attente : private/backlog.md (dépôt privé)."
fi
