#!/usr/bin/env bash
#MISE description="Vérifie les contrastes WCAG AA des rôles de couleur (norme Oxygen UI × Nord), thèmes clair et sombre (texte 4.5:1, UI 3:1)"
#USAGE flag "-v --verbose" help="Affiche toutes les paires, pas seulement les échecs"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

VERBOSE="${usage_verbose:-false}" python3 - site/stylesheets/extra.css <<'PY'
import os, re, sys

css = open(sys.argv[1], encoding="utf-8").read()
verbose = os.environ.get("VERBOSE") == "true"

def block(selector):
    """Contenu de tous les blocs dont le sélecteur est exactement `selector`."""
    out = ""
    for m in re.finditer(re.escape(selector) + r"\s*\{(.*?)\}", css, re.S):
        out += m.group(1)
    return out

def decls(text):
    return dict(re.findall(r"(--vt-[\w-]+)\s*:\s*([^;]+);", text))

root   = decls(block(":root"))
common = decls(block("[data-md-color-scheme]"))
themes = {
    "clair":  {**root, **common, **decls(block('[data-md-color-scheme="default"]'))},
    "sombre": {**root, **common, **decls(block('[data-md-color-scheme="slate"]'))},
}

def resolve(tokens, name, depth=0):
    """Couleur hexadécimale d'un token, ou (hex, alpha) pour color-mix(… X %, transparent)."""
    v = tokens.get(name)
    if v is None or depth > 10:
        return None
    v = " ".join(v.split())
    m = re.fullmatch(r"var\((--vt-[\w-]+)\)", v)
    if m:
        return resolve(tokens, m.group(1), depth + 1)
    m = re.fullmatch(r"color-mix\(in srgb, var\((--vt-[\w-]+)\) (?:var\((--vt-[\w-]+)\)|(\d+)%), transparent\)", v)
    if m:
        base = resolve(tokens, m.group(1), depth + 1)
        pct = tokens.get(m.group(2), "").strip() if m.group(2) else m.group(3) + "%"
        if isinstance(base, str) and pct.endswith("%"):
            return (base, float(pct[:-1]) / 100)
        return None
    return v if re.fullmatch(r"#[0-9a-fA-F]{6}", v) else None

def rgb(h):
    return [int(h[i:i + 2], 16) for i in (1, 3, 5)]

def flatten(fg, bg):
    """Couleur translucide posée sur son fond."""
    if isinstance(fg, tuple):
        (h, a), b = fg, rgb(bg)
        return "#" + "".join(f"{round(a * x + (1 - a) * y):02x}" for x, y in zip(rgb(h), b))
    return fg

def lum(h):
    c = [x / 255 for x in rgb(h)]
    c = [x / 12.92 if x <= 0.03928 else ((x + 0.055) / 1.055) ** 2.4 for x in c]
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]

def ratio(a, b):
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)

TEXT, UI = 4.5, 3.0     # WCAG 2.2 : 1.4.3 (texte courant) / 1.4.11 (composants, icônes, focus)
SYNTAX_TOLERATED = 4.3  # norme § 2 : nord15 et nord12 (4.4:1) tolérés en coloration syntaxique
SURFACES = ["bg-default", "bg-paper", "bg-raised"]
pairs = (
    # Texte courant et secondaire sur les trois niveaux de surface
    [("text-primary", s, TEXT) for s in SURFACES]
  + [("text-secondary", s, TEXT) for s in SURFACES]
  + [("text-primary", "action-selected", TEXT)]                     # texte surligné (mark)
    # Accent textuel : liens et boutons outlined sur la page et les surfaces de niveau 1
  + [("primary", s, TEXT) for s in ("bg-default", "bg-paper")]
  + [("primary-contrast", "primary", TEXT)]                         # bouton principal
  + [("error-text", s, TEXT) for s in ("bg-default", "bg-paper")]
    # Repères, focus et contours de cible (non textuels)
  + [(r, s, UI) for r in ("accent", "focus") for s in ("bg-default", "bg-paper")]
  + [("field-border", "bg-default", UI)]
    # Texte posé sur une couleur d'état pleine
  + [("on-state", s, TEXT) for s in ("warning", "success", "info", "highlight")]
    # Code en ligne et blocs de code (toujours sombres)
  + [("code-inline-fg", "code-inline-bg", TEXT)]
  + [(f"code-{k}", "code-bg", TEXT) for k in
     ("fg", "keyword", "function", "constant", "string", "comment", "generic", "punctuation")]
  + [(f"code-{k}", "code-bg", SYNTAX_TOLERATED) for k in ("number", "special")]
)

fail = 0
for theme, tokens in themes.items():
    print(f"• Thème {theme}")
    bad = 0
    for fg, bg, minimum in pairs:
        a, b = resolve(tokens, f"--vt-{fg}"), resolve(tokens, f"--vt-{bg}")
        if not a or not isinstance(b, str):
            print(f"  ✘ {fg} / {bg} : token introuvable ou non résolu"); bad += 1; continue
        r = ratio(flatten(a, b), b)
        ok = r >= minimum
        if not ok or verbose:
            print(f"  {'✔' if ok else '✘'} {fg:<18} sur {bg:<16} {r:5.2f}:1 (min {minimum})")
        bad += not ok
    if not bad:
        print(f"  ✔ OK ({len(pairs)} paires)")
    fail += bad
sys.exit(1 if fail else 0)
PY
