#!/usr/bin/env bash
#MISE description="Crée un brouillon d'article de blog daté"
#USAGE arg "<title>" help="Titre de l'article (entre guillemets)"
#USAGE flag "-c --category <category>" required=#true help="Thème = catégorie = service associé (titre exact d'un service, voir plugins.blog.categories_allowed de zensical.toml)"
#USAGE flag "--publish" help="Crée l'article publié directement (sans draft: true)"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"
source .mise/lib/zensical.sh

title="${usage_title:?titre requis}"
category="${usage_category:?catégorie requise, -c suivi du titre exact du service}"
date="$(date +%Y-%m-%d)"

# Slug : minuscules, sans accents, kebab-case
slug="$(python3 -c '
import re, sys, unicodedata
s = unicodedata.normalize("NFKD", sys.argv[1]).encode("ascii", "ignore").decode()
print(re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-"))
' "$title")"

# Catégories autorisées, lues dans zensical.toml
allowed="$(toml_get zensical.toml plugins.blog.categories_allowed)"
if ! grep -qxF "$category" <<<"$allowed"; then
  echo "✘ Catégorie inconnue : '$category'" >&2
  echo "  Autorisées : $(paste -sd, - <<<"$allowed" | sed 's/,/, /g')" >&2
  exit 1
fi

# Ancre du service sur la page Services (« ## Titre { #ancre } »)
# Ancre et pictogramme du service sur la page Services (« :material-x:</span> » puis « ## Titre { #ancre } »)
read -r anchor icon <<<"$(python3 -c '
import re, sys
for i, t, a in re.findall(r":material-([\w-]+):</span>\n\n## ([^\n{]+?) \{ *#([\w-]+) *\}", open("site/services.md", encoding="utf-8").read()):
    if t == sys.argv[1]: print(a, i)
' "$category")"
[[ -n "${anchor:-}" ]] || { echo "✘ Aucun service « $category » dans site/services.md" >&2; exit 1; }

file="site/blog/posts/${date}-${slug}.md"
[[ -e "$file" ]] && { echo "✘ Existe déjà : $file" >&2; exit 1; }

{
  echo "---"
  echo "date: ${date}"
  echo "authors:"
  echo "  - jerome"
  echo "categories:"
  echo "  - \"${category}\""
  echo "slug: ${slug}"
  echo "description: \"Résumé de l'article pour les moteurs de recherche (70 à 160 caractères).\""
  [[ "${usage_publish:-false}" == "true" ]] || echo "draft: true"
  echo "---"
  echo
  echo "Thème : :material-${icon}: [${category}](../../services.md#${anchor})"
  echo "{ .vt-post-service }"
  echo
  echo "# ${title}"
  echo
  echo "Accroche de l'article (affichée dans la liste du blog)."
  echo
  echo "<!-- more -->"
  echo
  echo "Corps de l'article…"
} > "$file"

echo "✔ Créé : $file"
