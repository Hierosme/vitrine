#!/usr/bin/env bash
#MISE description="Vérifie qu'aucun TODO ne figure dans les sources publiées, commentaires HTML compris (ils sont recopiés dans le HTML)"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

python3 - site <<'PY'
import pathlib, re, sys
bad = 0
for f in sorted(pathlib.Path(sys.argv[1]).rglob("*.md")):
    text = f.read_text(encoding="utf-8")
    if re.search(r"^draft:\s*true", text, re.M):
        continue                                        # brouillon : non publié
    # Les commentaires HTML du Markdown sont recopiés tels quels dans le HTML publié :
    # un TODO n'a donc sa place que dans le backlog privé (private/backlog.md).
    for n, line in enumerate(text.splitlines(), 1):
        if "TODO" in line:
            print(f"  ✘ {f}:{n} : {line.strip()}"); bad += 1
if not bad:
    print("  ✔ OK")
sys.exit(1 if bad else 0)
PY
