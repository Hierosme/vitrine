#!/usr/bin/env bash
#MISE description="Vérifie chaque service détaillé (## Titre { #ancre }) : au moins N caractères, formulé en mission type (aucune expérience citée)"
#USAGE flag "-m --min <min>" default="500" help="Nombre minimum de caractères visibles par service"
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

MIN="${usage_min:-500}" python3 - site/services.md <<'PY'
import os, re, sys

text = open(sys.argv[1], encoding="utf-8").read()
minimum = int(os.environ.get("MIN", "500"))

def visible(md):
    md = re.sub(r"<[^>]+>", "", md)                   # HTML
    md = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", md)  # liens → texte
    md = re.sub(r"\{[^}]*\}", "", md)                 # attributs
    md = re.sub(r"[*_`#>]", "", md)                   # emphase, titres, citations
    md = re.sub(r"^\s*- ", "", md, flags=re.M)        # puces
    return re.sub(r"\s+", " ", md).strip()

# Un service = une section H2 avec un identifiant explicite « ## Titre { #ancre } »
sections = list(re.finditer(r"^## ([^\n{]+?) \{ *#[\w-]+ *\}\n(.*?)(?=^## |\Z)", text, re.S | re.M))
if not sections:
    sys.exit(print("  ✘ aucun service détaillé trouvé dans site/services.md"))
# Missions types : un service ne cite ni expérience (employeur, client, année) ni passé à la 1re personne.
# Les noms viennent de vitrine-back/parcours.md, hors dépôt (titres « ### Poste — Entreprise, pour Client (années) »
# et clients en gras « **Client** : … ») ; sans ce fichier (clone public), seules les règles génériques s'appliquent.
names = set()
if os.path.exists("vitrine-back/parcours.md"):
    parcours = open("vitrine-back/parcours.md", encoding="utf-8").read()
    for h in re.findall(r"^### .+? — (.+?)(?: \(|$)", parcours, re.M):
        names.update(x.strip() for x in re.split(r",\s*pour\s+", h))
    names.update(n.strip() for n in re.findall(r"^\*\*([^*]+)\*\* :", parcours, re.M))
forbidden = [(n, re.compile(re.escape(n), re.I)) for n in names if n]
forbidden += [("année", re.compile(r"\b(19|20)\d{2}\b")), ("« j'ai »", re.compile(r"\bj'ai\b", re.I))]

bad = 0
for m in sections:
    title, body = m.group(1).strip(), visible(m.group(2))
    n = len(body)
    if n < minimum:
        bad += 1
        print(f"  ✘ {title} : {n} caractères (min {minimum})")
    hits = sorted({label for label, rx in forbidden if rx.search(body)})
    if hits:
        bad += 1
        print(f"  ✘ {title} : référence à une expérience ({', '.join(hits)}) — formuler en mission type")
if not bad:
    print(f"  ✔ OK ({len(sections)} services ≥ {minimum} caractères, formulés en missions types)")
sys.exit(1 if bad else 0)
PY
