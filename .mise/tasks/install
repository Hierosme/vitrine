#!/usr/bin/env bash
#MISE description="Synchronise .venv sur requirements.txt (Zensical et ses dépendances, versions verrouillées)"
#MISE sources=["requirements.txt"]
#MISE outputs=[".venv/.deps-installed"]
set -euo pipefail
cd "${MISE_PROJECT_ROOT:-.}"

# sync (et non install) : retire aussi du venv tout paquet absent du fichier verrouillé
uv pip sync requirements.txt
touch .venv/.deps-installed
